@using EthiopianCalendarPortal.Helpers
<div class="row g-4">
    @foreach (var item in holidaysList)
    {
        <div class="col-sm-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 @GetCardAccentClass(item.HolidayName) holiday-card">
                <div class="card-body">
                    <div class="day-badge mb-3 @GetBadgeClass(item.HolidayName)">
                        @AmharicTranslator.ToAmharicDay(item.DayOfWeek)
                    </div>

                    <h5 class="card-title fw-bold text-dark mb-3 holiday-title">
                        @AmharicTranslator.ToAmharicHoliday(item.HolidayName)
                    </h5>

                    <div class="date-box ec-box mb-2">
                        <span class="small text-muted fw-semibold">Ethiopian (E.C.)</span>
                        <span class="date-value ec-value">
                            @AmharicTranslator.ToAmharicMonth(item.EthiopianMonth) @item.EthiopianDay
                        </span>
                    </div>

                    <div class="date-box gc-box">
                        <span class="small text-muted fw-semibold">Gregorian (G.C.)</span>
                        <span class="date-value gc-value">
                            @item.GregorianMonth @item.GregorianDay, @item.GregorianYear
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
