@page "/ethiopian-calendar"
@using EthiopianCalendarPortal.Pages
@using System.Linq

<style>
    .ec-root, .ec-root * {
        box-sizing: border-box;
        font-family: 'Georgia', 'Times New Roman', serif;
    }
    .ec-root {
        --ec-gold: #B8860B;
        --ec-gold-light: #FDF6E3;
        --ec-red: #8B1A1A;
        --ec-red-light: #FDF0F0;
        --ec-blue: #1A4A8A;
        --ec-blue-light: #EFF6FF;
        --ec-surface: #F7F5F0;
        --ec-border: rgba(0,0,0,0.09);
        --ec-dark: #181612;
        background: var(--ec-surface);
        min-height: 100vh;
    }
    .ec-topbar {
        background: var(--ec-dark);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.7rem 1.75rem;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .ec-topbar-title {
        font-size: 1rem;
        font-weight: bold;
        color: #D4AA50;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }
    .ec-today-display {
        text-align: center;
        line-height: 1.3;
    }
    .ec-today-eth {
        font-size: 0.95rem;
        font-weight: bold;
        color: #FFD700;
        font-family: sans-serif;
    }
    .ec-today-greg {
        font-size: 0.72rem;
        color: #AAA;
        font-family: sans-serif;
    }
    .ec-year-form {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: sans-serif;
    }
    .ec-year-form label {
        font-size: 0.78rem;
        color: #888;
        white-space: nowrap;
    }
    .ec-year-form input[type=number] {
        width: 88px;
        background: #252320;
        border: 1px solid #3A3830;
        color: #F0EAD6;
        border-radius: 5px;
        padding: 4px 8px;
        font-size: 0.85rem;
        font-family: sans-serif;
    }
    .ec-year-form button {
        background: var(--ec-gold);
        color: #fff;
        border: none;
        border-radius: 5px;
        padding: 4px 16px;
        font-size: 0.82rem;
        font-weight: bold;
        cursor: pointer;
        font-family: sans-serif;
        letter-spacing: 0.03em;
    }
    .ec-year-form button:hover { background: #9A6F00; }
    .ec-nav-strip {
        background: #fff;
        border-bottom: 1px solid var(--ec-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.75rem;
        gap: 1rem;
    }
    .ec-nav-btn {
        background: none;
        border: 1.5px solid #D0C8B8;
        border-radius: 50%;
        width: 38px;
        height: 38px;
        cursor: pointer;
        font-size: 1rem;
        color: #666;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: border-color 0.15s, color 0.15s;
        flex-shrink: 0;
        font-family: sans-serif;
    }
    .ec-nav-btn:hover:not(:disabled) { border-color: var(--ec-gold); color: var(--ec-gold); }
    .ec-nav-btn:disabled { opacity: 0.28; cursor: default; }
    .ec-month-title { text-align: center; flex: 1; line-height: 1.2; }
    .ec-month-amharic { font-size: 1.55rem; font-weight: bold; color: var(--ec-dark); display: block; }
    .ec-month-english { font-size: 0.72rem; color: #999; letter-spacing: 0.1em; text-transform: uppercase; display: block; font-family: sans-serif; margin-top: 1px; }
    .ec-month-gyear { font-size: 0.75rem; color: #B89A50; display: block; font-family: sans-serif; margin-top: 2px; }
    .ec-dots {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        padding: 0.45rem 1.75rem;
        background: #fff;
        border-bottom: 1px solid var(--ec-border);
        flex-wrap: wrap;
    }
    .ec-dot-btn {
        border: none;
        background: #DDD8CC;
        border-radius: 50%;
        width: 9px;
        height: 9px;
        cursor: pointer;
        padding: 0;
        transition: background 0.15s, transform 0.1s;
    }
    .ec-dot-btn:hover { background: #B8A870; }
    .ec-dot-btn.active { background: var(--ec-gold); transform: scale(1.4); }
    .ec-dot-btn.pagume { width: 7px; height: 7px; background: #CCC8C0; }
    .ec-dot-btn.pagume.active { background: var(--ec-gold); }
    .ec-legend {
        display: flex;
        gap: 1.2rem;
        flex-wrap: wrap;
        padding: 0.5rem 1.75rem;
        background: #fff;
        border-bottom: 1px solid var(--ec-border);
        font-family: sans-serif;
        font-size: 0.72rem;
        color: #666;
        align-items: center;
    }
    .ec-legend-item { display: flex; align-items: center; gap: 5px; }
    .ec-legend-swatch { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .ec-layout {
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 1.75rem;
        max-width: 1050px;
        margin: 0 auto;
        padding: 1.75rem;
        align-items: start;
    }
    @@media (max-width: 860px) {
        .ec-layout { grid-template-columns: 1fr; padding: 1rem; }
        .ec-today-display { display: none; }
    }
    .ec-cal-card {
        background: #fff;
        border: 1px solid var(--ec-border);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 14px rgba(0,0,0,0.06);
    }
    .ec-weekday-row {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        background: var(--ec-dark);
    }
    .ec-wday { text-align: center; padding: 0.55rem 0; font-size: 0.68rem; font-weight: bold; letter-spacing: 0.07em; font-family: sans-serif; color: #9A9080; }
    .ec-wday.sunday { color: #D07070; }
    .ec-days-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: #EEEAE2; }
    .ec-cell { background: #fff; min-height: 64px; padding: 6px 5px 5px; display: flex; flex-direction: column; align-items: center; cursor: default; transition: background 0.1s; }
    .ec-cell:hover { background: #FAFAF5; }
    .ec-cell.empty { background: #F9F7F3; }
    .ec-cell.sunday .ec-eth { color: #B03030; }
    .ec-cell.is-annual { background: var(--ec-gold-light); }
    .ec-cell.is-movable { background: var(--ec-red-light); }
    .ec-cell.is-monthly { background: var(--ec-blue-light); }
    .ec-cell.is-today { background: #FFD700 !important; border: 2px solid #FFA500; }
    .ec-eth { font-size: 1.1rem; font-weight: bold; color: var(--ec-dark); line-height: 1; }
    .ec-greg { font-size: 0.58rem; color: #AAA; margin-top: 3px; font-family: sans-serif; white-space: nowrap; }
    .ec-feast-dot { width: 5px; height: 5px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
    .ec-feast-dot.annual { background: var(--ec-gold); }
    .ec-feast-dot.movable { background: var(--ec-red); }
    .ec-feast-dot.monthly { background: var(--ec-blue); }
    .ec-side { display: flex; flex-direction: column; gap: 1rem; }
    .ec-this-month { background: #fff; border: 1px solid var(--ec-border); border-radius: 10px; overflow: hidden; }
    .ec-this-month-head { background: var(--ec-dark); color: #D4AA50; padding: 0.55rem 1rem; font-size: 0.72rem; font-weight: bold; letter-spacing: 0.08em; text-transform: uppercase; font-family: sans-serif; }
    .ec-feast-list { list-style: none; margin: 0; padding: 0; background: #fff; }
    .ec-feast-item { display: flex; align-items: baseline; gap: 8px; padding: 0.5rem 0.9rem; border-bottom: 1px solid #F3F0EA; font-size: 0.78rem; color: #333; line-height: 1.4; font-family: sans-serif; }
    .ec-feast-item:last-child { border-bottom: none; }
    .ec-feast-item .fdot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
    .ec-feast-item .fdot.annual { background: var(--ec-gold); }
    .ec-feast-item .fdot.movable { background: var(--ec-red); }
    .ec-feast-item .fdot.monthly { background: var(--ec-blue); }
    .ec-feast-item strong { color: #111; font-family: sans-serif; }
    .ec-no-feasts { padding: 0.9rem 1rem; font-size: 0.78rem; color: #AAA; text-align: center; font-family: sans-serif; }
    .ec-empty-state { padding: 3rem; text-align: center; color: #AAA; font-size: 1rem; font-family: sans-serif; }
</style>

<div class="ec-root">
    <div class="ec-topbar">
        <div class="ec-topbar-title">
    <img src="https://flagcdn.com/w20/et.png" 
         srcset="https://flagcdn.com/w40/et.png 2x"
         alt="Ethiopia" 
         style="height:16px; vertical-align:middle; margin-right:6px; border-radius:2px;" />
    Ethiopian Calendar &amp; EOTC Feast Guide
</div>

        <div class="ec-today-display">
            <div class="ec-today-eth">@GetTodayEthiopianLabel()</div>
            <div class="ec-today-greg">@DateTime.UtcNow.ToString("dddd, MMMM d, yyyy")</div>
        </div>

        <div class="ec-year-form">
            <label>Ethiopian Year (E.C.):</label>
            <input type="number" @bind="inputYear" min="1" max="9999" />
            <button @onclick="GenerateCalendar">Go</button>
        </div>
    </div>

    @if (monthsData != null && currentMonth != null)
    {
        <div class="ec-nav-strip">
            <button class="ec-nav-btn" @onclick="PrevMonth" disabled="@(currentMonthIndex == 0)">&#8592;</button>
            <div class="ec-month-title">
                <span class="ec-month-amharic">@currentMonth.AmharicName</span>
                <span class="ec-month-english">@currentMonth.EnglishName &nbsp;&middot;&nbsp; @displayedYear E.C.</span>
                <span class="ec-month-gyear">G.C. @currentMonth.GregorianYearText</span>
            </div>
            <button class="ec-nav-btn" @onclick="NextMonth" disabled="@(currentMonthIndex == monthsData.Count - 1)">&#8594;</button>
        </div>

        <div class="ec-dots">
            @for (int i = 0; i < monthsData.Count; i++)
            {
                var idx = i;
                var isPagume = (i == 12);
                var isActive = (idx == currentMonthIndex);
                <button class="ec-dot-btn @(isPagume ? "pagume" : "") @(isActive ? "active" : "")"
                        title="@monthsData[i].AmharicName (@monthsData[i].EnglishName)"
                        @onclick="() => { currentMonthIndex = idx; }"></button>
            }
        </div>

        <div class="ec-legend">
            <span>Feast key:</span>
            <span class="ec-legend-item"><span class="ec-legend-swatch" style="background:var(--ec-gold);"></span>Holiday</span>
            <span class="ec-legend-item"><span class="ec-legend-swatch" style="background:var(--ec-red);"></span>Movable feast</span>
            <span class="ec-legend-item"><span class="ec-legend-swatch" style="background:var(--ec-blue);"></span>Monthly saint</span>
        </div>

        <div class="ec-layout">
            <div class="ec-cal-card">
                <div class="ec-weekday-row">
                    @for (int w = 0; w < weekdayHeaders.Length; w++)
                    {
                        var wIdx = w;
                        <div class="ec-wday @(wIdx == 0 ? "sunday" : "")">@weekdayHeaders[wIdx]</div>
                    }
                </div>
                <div class="ec-days-grid">
                    @for (int e = 0; e < currentMonth.StartWeekday; e++)
                    {
                        <div class="ec-cell empty"></div>
                    }
                    @foreach (var d in currentMonth.Days)
                    {
                        var typeClass = GetTypeClass(d.BgClass);
                        var colIndex = (currentMonth.StartWeekday + d.EthiopianDay - 1) % 7;
                        var isSunday = (colIndex == 0);
                        var dotClass = GetDotClass(d.BgClass);
                        var hasHoliday = !string.IsNullOrEmpty(d.HolidayName);
                        var isToday = IsToday(d.EthiopianDay);
                        <div class="ec-cell @typeClass @(isSunday ? "sunday" : "") @(isToday ? "is-today" : "")" title="@(hasHoliday ? d.HolidayName : "")">
                            <span class="ec-eth">@d.EthiopianDay</span>
                            <span class="ec-greg">@d.GregorianDateText</span>
                            @if (hasHoliday)
                            {
                                <div class="ec-feast-dot @dotClass"></div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="ec-side">
                <div class="ec-this-month">
                    <div class="ec-this-month-head">Feasts in @currentMonth.AmharicName</div>
                    @{
                        var feasts = currentMonth.Days.Where(d => !string.IsNullOrEmpty(d.HolidayName)).ToList();
                    }
                    @if (!feasts.Any())
                    {
                        <p class="ec-no-feasts">No special feasts this month.</p>
                    }
                    else
                    {
                        <ul class="ec-feast-list">
                            @foreach (var f in feasts)
                            {
                                var fc = GetDotClass(f.BgClass);
                                <li class="ec-feast-item">
                                    <span class="fdot @fc"></span>
                                    <span>Day <strong>@f.EthiopianDay</strong> &mdash; @f.HolidayName</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="ec-empty-state">Enter an Ethiopian year above and press Go to generate the calendar.</div>
    }
</div>
