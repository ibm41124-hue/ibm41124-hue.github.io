@page "/ethiopian-calendar"
@using System
@using EthiopianCalendarPortal.Pages

<style>
    .ec-root, .ec-root * {
        box-sizing: border-box;
        font-family: 'Georgia', 'Times New Roman', serif;
    }
    .ec-root {
        --ec-gold: #B8860B;
        --ec-gold-light: #FDF6E3;
        --ec-red: #8B1A1A;
        --ec-red-light: #FDF0F0;
        --ec-blue: #1A4A8A;
        --ec-blue-light: #EFF6FF;
        --ec-surface: #F7F5F0;
        --ec-border: rgba(0,0,0,0.09);
        --ec-dark: #181612;
        background: var(--ec-surface);
        min-height: 100vh;
    }
    .ec-topbar {
        background: var(--ec-dark);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.7rem 1.75rem;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .ec-topbar-title {
        font-size: 1rem;
        font-weight: bold;
        color: #D4AA50;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }
    .ec-year-form {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: sans-serif;
    }
    .ec-year-form label {
        font-size: 0.78rem;
        color: #888;
        white-space: nowrap;
    }
    .ec-year-form input[type=number] {
        width: 88px;
        background: #252320;
        border: 1px solid #3A3830;
        color: #F0EAD6;
        border-radius: 5px;
        padding: 4px 8px;
        font-size: 0.85rem;
        font-family: sans-serif;
    }
    .ec-year-form button {
        background: var(--ec-gold);
        color: #fff;
        border: none;
        border-radius: 5px;
        padding: 4px 16px;
        font-size: 0.82rem;
        font-weight: bold;
        cursor: pointer;
        font-family: sans-serif;
        letter-spacing: 0.03em;
    }
    .ec-year-form button:hover { background: #9A6F00; }
    .ec-nav-strip {
        background: #fff;
        border-bottom: 1px solid var(--ec-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.75rem;
        gap: 1rem;
    }
    .ec-nav-btn {
        background: none;
        border: 1.5px solid #D0C8B8;
        border-radius: 50%;
        width: 38px;
        height: 38px;
        cursor: pointer;
        font-size: 1rem;
        color: #666;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: border-color 0.15s, color 0.15s;
        flex-shrink: 0;
        font-family: sans-serif;
    }
    .ec-nav-btn:hover:not(:disabled) { border-color: var(--ec-gold); color: var(--ec-gold); }
    .ec-nav-btn:disabled { opacity: 0.28; cursor: default; }
    .ec-month-title { text-align: center; flex: 1; line-height: 1.2; }
    .ec-month-amharic { font-size: 1.55rem; font-weight: bold; color: var(--ec-dark); display: block; }
    .ec-month-english { font-size: 0.72rem; color: #999; letter-spacing: 0.1em; text-transform: uppercase; display: block; font-family: sans-serif; margin-top: 1px; }
    .ec-month-gyear { font-size: 0.75rem; color: #B89A50; display: block; font-family: sans-serif; margin-top: 2px; }
    .ec-dots {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        padding: 0.45rem 1.75rem;
        background: #fff;
        border-bottom: 1px solid var(--ec-border);
        flex-wrap: wrap;
    }
    .ec-dot-btn {
        border: none;
        background: #DDD8CC;
        border-radius: 50%;
        width: 9px;
        height: 9px;
        cursor: pointer;
        padding: 0;
        transition: background 0.15s, transform 0.1s;
    }
    .ec-dot-btn:hover { background: #B8A870; }
    .ec-dot-btn.active { background: var(--ec-gold); transform: scale(1.4); }
    .ec-dot-btn.pagume { width: 7px; height: 7px; background: #CCC8C0; }
    .ec-dot-btn.pagume.active { background: var(--ec-gold); }
    .ec-legend {
        display: flex;
        gap: 1.2rem;
        flex-wrap: wrap;
        padding: 0.5rem 1.75rem;
        background: #fff;
        border-bottom: 1px solid var(--ec-border);
        font-family: sans-serif;
        font-size: 0.72rem;
        color: #666;
        align-items: center;
    }
    .ec-legend-item { display: flex; align-items: center; gap: 5px; }
    .ec-legend-swatch { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .ec-layout {
        display: grid;
        grid-template-columns: 1fr 330px;
        gap: 1.75rem;
        max-width: 1180px;
        margin: 0 auto;
        padding: 1.75rem;
        align-items: start;
    }
    @@media (max-width: 860px) {
        .ec-layout { grid-template-columns: 1fr; padding: 1rem; }
    }
    .ec-cal-card {
        background: #fff;
        border: 1px solid var(--ec-border);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 14px rgba(0,0,0,0.06);
    }
    .ec-weekday-row {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        background: var(--ec-dark);
    }
    .ec-wday { text-align: center; padding: 0.55rem 0; font-size: 0.68rem; font-weight: bold; letter-spacing: 0.07em; font-family: sans-serif; color: #9A9080; }
    .ec-wday.sunday { color: #D07070; }
    .ec-days-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: #EEEAE2; }
    .ec-cell { background: #fff; min-height: 64px; padding: 6px 5px 5px; display: flex; flex-direction: column; align-items: center; cursor: default; transition: background 0.1s; }
    .ec-cell:hover { background: #FAFAF5; }
    .ec-cell.empty { background: #F9F7F3; }
    .ec-cell.sunday .ec-eth { color: #B03030; }
    .ec-cell.is-annual  { background: var(--ec-gold-light); }
    .ec-cell.is-movable { background: var(--ec-red-light); }
    .ec-cell.is-monthly { background: var(--ec-blue-light); }
    .ec-eth { font-size: 1.1rem; font-weight: bold; color: var(--ec-dark); line-height: 1; }
    .ec-greg { font-size: 0.58rem; color: #AAA; margin-top: 3px; font-family: sans-serif; white-space: nowrap; }
    .ec-feast-dot { width: 5px; height: 5px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
    .ec-feast-dot.annual  { background: var(--ec-gold); }
    .ec-feast-dot.movable { background: var(--ec-red); }
    .ec-feast-dot.monthly { background: var(--ec-blue); }
    .ec-side { display: flex; flex-direction: column; gap: 1rem; }
    .ec-this-month { background: #fff; border: 1px solid var(--ec-border); border-radius: 10px; overflow: hidden; }
    .ec-this-month-head { background: var(--ec-dark); color: #D4AA50; padding: 0.55rem 1rem; font-size: 0.72rem; font-weight: bold; letter-spacing: 0.08em; text-transform: uppercase; font-family: sans-serif; }
    .ec-feast-list { list-style: none; margin: 0; padding: 0; background: #fff; }
    .ec-feast-item { display: flex; align-items: baseline; gap: 8px; padding: 0.5rem 0.9rem; border-bottom: 1px solid #F3F0EA; font-size: 0.78rem; color: #333; line-height: 1.4; font-family: sans-serif; }
    .ec-feast-item:last-child { border-bottom: none; }
    .ec-feast-item .fdot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
    .ec-feast-item .fdot.annual  { background: var(--ec-gold); }
    .ec-feast-item .fdot.movable { background: var(--ec-red); }
    .ec-feast-item .fdot.monthly { background: var(--ec-blue); }
    .ec-feast-item strong { color: #111; font-family: sans-serif; }
    .ec-no-feasts { padding: 0.9rem 1rem; font-size: 0.78rem; color: #AAA; text-align: center; font-family: sans-serif; }
    .ec-glossary { border: 1px solid var(--ec-border); border-radius: 10px; overflow: hidden; }
    .ec-gloss-head { padding: 0.6rem 1rem; font-size: 0.75rem; font-weight: bold; letter-spacing: 0.04em; font-family: sans-serif; display: flex; align-items: center; gap: 6px; }
    .ec-gloss-head.annual  { background: #FDF3DC; color: #7A5800; border-bottom: 1px solid #EDD990; }
    .ec-gloss-head.movable { background: var(--ec-red-light); color: #6A1414; border-bottom: 1px solid #F0B8B8; }
    .ec-gloss-head.monthly { background: var(--ec-blue-light); color: #1E3A8A; border-bottom: 1px solid #C0D8F8; }
    .ec-empty-state { padding: 3rem; text-align: center; color: #AAA; font-size: 1rem; font-family: sans-serif; }
</style>

<div class="ec-root">

    <div class="ec-topbar">
        <div class="ec-topbar-title">&#127466;&#127481; Ethiopian Calendar &amp; EOTC Feast Guide</div>
        <div class="ec-year-form">
            <label>Ethiopian Year (E.C.):</label>
            <input type="number" @bind="inputYear" min="1" max="9999" />
            <button @onclick="GenerateCalendar">Go</button>
        </div>
    </div>

    @if (monthsData != null && currentMonth != null)
    {
        <div class="ec-nav-strip">
            <button class="ec-nav-btn" @onclick="PrevMonth" disabled="@(currentMonthIndex == 0)">&#8592;</button>
            <div class="ec-month-title">
                <span class="ec-month-amharic">@currentMonth.AmharicName</span>
                <span class="ec-month-english">@currentMonth.EnglishName &nbsp;&middot;&nbsp; @displayedYear E.C.</span>
                <span class="ec-month-gyear">G.C. @currentMonth.GregorianYearText</span>
            </div>
            <button class="ec-nav-btn" @onclick="NextMonth" disabled="@(currentMonthIndex == monthsData.Count - 1)">&#8594;</button>
        </div>

        <div class="ec-dots">
            @for (int i = 0; i < monthsData.Count; i++)
            {
                var idx = i;
                var isPagume = (i == 12);
                var isActive = (idx == currentMonthIndex);
                <button class="ec-dot-btn @(isPagume ? "pagume" : "") @(isActive ? "active" : "")"
                        title="@monthsData[i].AmharicName (@monthsData[i].EnglishName)"
                        @onclick="() => currentMonthIndex = idx"></button>
            }
        </div>

        <div class="ec-legend">
            <span>Feast key:</span>
            <span class="ec-legend-item"><span class="ec-legend-swatch" style="background:var(--ec-gold);"></span>Annual holiday</span>
            <span class="ec-legend-item"><span class="ec-legend-swatch" style="background:var(--ec-red);"></span>Movable feast</span>
            <span class="ec-legend-item"><span class="ec-legend-swatch" style="background:var(--ec-blue);"></span>Monthly saint day</span>
        </div>

        <div class="ec-layout">

            <div class="ec-cal-card">
                <div class="ec-weekday-row">
                    @for (int w = 0; w < weekdayHeaders.Length; w++)
                    {
                        var wIdx = w;
                        <div class="ec-wday @(wIdx == 6 ? "sunday" : "")">@weekdayHeaders[wIdx]</div>
                    }
                </div>
                <div class="ec-days-grid">
                    @for (int e = 0; e < currentMonth.StartWeekday; e++)
                    {
                        <div class="ec-cell empty"></div>
                    }
                    @foreach (var d in currentMonth.Days)
                    {
                        var typeClass  = GetTypeClass(d.BgClass);
                        var colIndex   = (currentMonth.StartWeekday + d.EthiopianDay - 1) % 7;
                        var isSunday   = (colIndex == 6);
                        var dotClass   = GetDotClass(d.BgClass);
                        var hasHoliday = !string.IsNullOrEmpty(d.HolidayName);
                        <div class="ec-cell @typeClass @(isSunday ? "sunday" : "")"
                             title="@(hasHoliday ? d.HolidayName : "")">
                            <span class="ec-eth">@d.EthiopianDay</span>
                            <span class="ec-greg">@d.GregorianDateText</span>
                            @if (hasHoliday)
                            {
                                <div class="ec-feast-dot @dotClass"></div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="ec-side">

                <div class="ec-this-month">
                    <div class="ec-this-month-head">Feasts in @currentMonth.AmharicName</div>
                    @{
                        var feasts = currentMonth.Days
                            .Where(d => !string.IsNullOrEmpty(d.HolidayName))
                            .ToList();
                    }
                    @if (!feasts.Any())
                    {
                        <p class="ec-no-feasts">No special feasts this month.</p>
                    }
                    else
                    {
                        <ul class="ec-feast-list">
                            @foreach (var f in feasts)
                            {
                                var fc = GetDotClass(f.BgClass);
                                <li class="ec-feast-item">
                                    <span class="fdot @fc"></span>
                                    <span>Day <strong>@f.EthiopianDay</strong> &mdash; @f.HolidayName</span>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <div class="ec-glossary">
                    <div class="ec-gloss-head annual">&#x1F7E1; Major Annual Holidays (በዓላት)</div>
                    <ul class="ec-feast-list">
                        <li class="ec-feast-item"><span class="fdot annual"></span><span><strong>እንቁጣጣሽ / ቅዱስ ዮሐንስ (Meskerem 1):</strong> Ethiopian New Year, end of rainy season.</span></li>
                        <li class="ec-feast-item"><span class="fdot annual"></span><span><strong>መስቀል (Meskerem 17):</strong> Finding of the True Cross; Demera bonfire.</span></li>
                        <li class="ec-feast-item"><span class="fdot annual"></span><span><strong>ልደት / Genna (Tahsas 29):</strong> Christmas, Christ's Nativity.</span></li>
                        <li class="ec-feast-item"><span class="fdot annual"></span><span><strong>ጥምቀት (Ter 11):</strong> Epiphany, Christ's Baptism in the Jordan.</span></li>
                        <li class="ec-feast-item"><span class="fdot annual"></span><span><strong>ቃና ዘገሊላ (Ter 12):</strong> Christ's first miracle at Cana.</span></li>
                        <li class="ec-feast-item"><span class="fdot annual"></span><span><strong>ደብረ ታቦር (Nehase 13):</strong> Transfiguration of Jesus (Buhe).</span></li>
                    </ul>
                </div>

                <div class="ec-glossary">
                    <div class="ec-gloss-head movable">&#x1F534; Movable Bahire Hasab Feasts</div>
                    <ul class="ec-feast-list">
                        <li class="ec-feast-item"><span class="fdot movable"></span><span><strong>ጾመ ነነዌ (Nineveh Fast):</strong> Three-day fast before Great Lent.</span></li>
                        <li class="ec-feast-item"><span class="fdot movable"></span><span><strong>ዐቢይ ጾም (Great Lent):</strong> 55-day holy fast.</span></li>
                        <li class="ec-feast-item"><span class="fdot movable"></span><span><strong>ደብረ ዘይት (Mount of Olives):</strong> Mid-Lent Sunday.</span></li>
                        <li class="ec-feast-item"><span class="fdot movable"></span><span><strong>ሆሣዕና (Palm Sunday):</strong> Christ's entry into Jerusalem.</span></li>
                        <li class="ec-feast-item"><span class="fdot movable"></span><span><strong>ስቅለት (Good Friday):</strong> Christ's crucifixion.</span></li>
                        <li class="ec-feast-item"><span class="fdot movable"></span><span><strong>ትንሣኤ (Easter):</strong> Christ's resurrection.</span></li>
                        <li class="ec-feast-item"><span class="fdot movable"></span><span><strong>ርክበ ካህናት (Assembly of Priests):</strong> Midway Easter to Pentecost.</span></li>
                        <li class="ec-feast-item"><span class="fdot movable"></span><span><strong>ዕርገት (Ascension):</strong> Jesus ascends into heaven.</span></li>
                        <li class="ec-feast-item"><span class="fdot movable"></span><span><strong>ጰራቅሊጦስ (Pentecost):</strong> Descent of the Holy Spirit.</span></li>
                        <li class="ec-feast-item"><span class="fdot movable"></span><span><strong>ጾመ ሐዋርያት (Apostles Fast):</strong> Fast after Pentecost.</span></li>
                    </ul>
                </div>

                <div class="ec-glossary">
                    <div class="ec-gloss-head monthly">&#x1F535; Monthly Commemorated Days</div>
                    <ul class="ec-feast-list">
                        <li class="ec-feast-item"><span class="fdot monthly"></span><span><strong>Day 5 &mdash; አቡነ ገብረ መንፈስ ቅዱስ:</strong> Desert hermit saint.</span></li>
                        <li class="ec-feast-item"><span class="fdot monthly"></span><span><strong>Day 7 &mdash; ሥላሴ (Holy Trinity):</strong> Monthly honor of the Triune Godhead.</span></li>
                        <li class="ec-feast-item"><span class="fdot monthly"></span><span><strong>Day 12 &mdash; ቅዱስ ሚካኤል (St. Michael):</strong> Chief protector archangel.</span></li>
                        <li class="ec-feast-item"><span class="fdot monthly"></span><span><strong>Day 16 &mdash; ቅድስት ኪዳነ ምሕረት (Kidane Mihret):</strong> Covenant of Mercy, St. Mary.</span></li>
                        <li class="ec-feast-item"><span class="fdot monthly"></span><span><strong>Day 19 &mdash; ቅዱስ ገብርኤል (St. Gabriel):</strong> Archangel, messenger of tidings.</span></li>
                        <li class="ec-feast-item"><span class="fdot monthly"></span><span><strong>Day 21 &mdash; ቅድስት ማርያም (St. Mary):</strong> Monthly Marian covenant.</span></li>
                        <li class="ec-feast-item"><span class="fdot monthly"></span><span><strong>Day 23 &mdash; ቅዱስ ጊዮርጊስ (St. George):</strong> Great Martyr, Star of the East.</span></li>
                        <li class="ec-feast-item"><span class="fdot monthly"></span><span><strong>Day 27 &mdash; መድኃኔዓለም (Savior of the World):</strong> Christ, Redeemer of all.</span></li>
                        <li class="ec-feast-item"><span class="fdot monthly"></span><span><strong>Day 29 &mdash; በዓለ ወልድ (Feast of the Son):</strong> Celebration of God the Son.</span></li>
                    </ul>
                </div>

            </div>
        </div>
    }
    else
    {
        <div class="ec-empty-state">Enter an Ethiopian year above and press Go to generate the calendar.</div>
    }

</div>

@code {
    private int currentMonthIndex = 0;
    private int inputYear = 2018;
    private int displayedYear = 2018;
    private List<MonthModel>? monthsData;
    private readonly string[] weekdayHeaders = { "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN" };

    private MonthModel? currentMonth =>
        (monthsData != null && currentMonthIndex >= 0 && currentMonthIndex < monthsData.Count)
            ? monthsData[currentMonthIndex]
            : null;

    protected override void OnInitialized()
    {
        GenerateCalendar();
    }

    private void GenerateCalendar()
    {
        displayedYear = inputYear;
        monthsData = BuildMonths(displayedYear);
        currentMonthIndex = 0;
    }

    private void PrevMonth()
    {
        if (currentMonthIndex > 0) currentMonthIndex--;
    }

    private void NextMonth()
    {
        if (monthsData != null && currentMonthIndex < monthsData.Count - 1)
            currentMonthIndex++;
    }

    private List<MonthModel> BuildMonths(int ethiopianYear)
    {
        var months = new List<MonthModel>();
        var monthNames = new[]
        {
            ("መስከረም", "Meskerem"), ("ጥቅምት", "Tikimt"), ("ኅዳር", "Hidar"),
            ("ታኅሣሥ", "Tahsas"), ("ጥር", "Tir"), ("የካቲት", "Yekatit"),
            ("መጋቢት", "Megabit"), ("ሚያዝያ", "Miyazya"), ("ግንቦት", "Ginbot"),
            ("ሰኔ", "Sene"), ("ሐምሌ", "Hamle"), ("ነሐሴ", "Nehase"), ("ጳጉሜ", "Pagume")
        };

        var gYearStart = ethiopianYear + 7;
        var newYearGregorian = EthiopianNewYearGregorianDate(ethiopianYear);
        var isLeap = IsEthiopianLeapYear(ethiopianYear);
        var daysInLastMonth = isLeap ? 6 : 5;

        for (int i = 0; i < 13; i++)
        {
            int daysInMonth = i == 12 ? daysInLastMonth : 30;
            var monthStart = newYearGregorian.AddDays(i * 30);
            var days = new List<DayModel>();

            for (int d = 1; d <= daysInMonth; d++)
            {
                var gDate = monthStart.AddDays(d - 1);
                days.Add(new DayModel
                {
                    EthiopianDay = d,
                    GregorianDateText = gDate.ToString("MMM d, yyyy"),
                    HolidayName = GetHolidayName(i + 1, d),
                    BgClass = GetBgClass(i + 1, d)
                });
            }

            months.Add(new MonthModel
            {
                EthiopianMonth = i + 1,
                EthiopianYear = ethiopianYear,
                AmharicName = monthNames[i].Item1,
                EnglishName = monthNames[i].Item2,
                GregorianYearText = i == 12 && !isLeap ? $"{gYearStart}/{gYearStart + 1}" : $"{monthStart:yyyy}",
                StartWeekday = (int)monthStart.DayOfWeek == 0 ? 6 : ((int)monthStart.DayOfWeek - 1),
                Days = days
            });
        }

        return months;
    }

    private DateTime EthiopianNewYearGregorianDate(int ethiopianYear)
    {
        var gy = ethiopianYear + 7;
        return new DateTime(gy, 9, 11);
    }

    private bool IsEthiopianLeapYear(int ethiopianYear) => ethiopianYear % 4 == 3;

    private string? GetHolidayName(int month, int day)
    {
        return (month, day) switch
        {
            (1, 1) => "Ethiopian New Year",
            (1, 17) => "Meskel",
            (4, 29) => "Christmas (Genna)",
            (5, 11) => "Timkat",
            (5, 12) => "Cana",
            (12, 13) => "Debre Tabor",
            _ => null
        };
    }

    private string? GetBgClass(int month, int day)
    {
        return GetHolidayName(month, day) switch
        {
            "Ethiopian New Year" or "Meskel" or "Christmas (Genna)" or "Timkat" or "Cana" or "Debre Tabor" => "bg-warning",
            _ => null
        };
    }

    private string GetTypeClass(string? bgClass)
    {
        if (string.IsNullOrEmpty(bgClass)) return "";
        if (bgClass.Contains("warning")) return "is-annual";
        if (bgClass.Contains("danger")) return "is-movable";
        if (bgClass.Contains("info")) return "is-monthly";
        return "";
    }

    private string GetDotClass(string? bgClass)
    {
        if (string.IsNullOrEmpty(bgClass)) return "";
        if (bgClass.Contains("warning")) return "annual";
        if (bgClass.Contains("danger")) return "movable";
        if (bgClass.Contains("info")) return "monthly";
        return "";
    }
}
