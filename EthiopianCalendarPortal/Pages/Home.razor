@page "/"
@using BahireHasab.Core
@using System.IO
@inject IJSRuntime JS

<PageTitle>Ethiopian Calendar Portal</PageTitle>

<div class="container py-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">ባሕረ ሐሳብ — Bahire Hasab</h1>
        <p class="lead text-muted">Calculate Ethiopian Fasting Days and Liturgical Holidays using modern .NET technology</p>
    </div>

    <!-- Input Form Card -->
    <div class="no-print card shadow-sm border-0 max-width-form mx-auto mb-5 p-4 bg-light">
        <div class="row g-3 align-items-center justify-content-center">
            <div class="col-md-7">
                <label for="yearInput" class="form-label fw-semibold text-secondary">Enter Ethiopian Year (E.C.)</label>
                <input type="number" id="yearInput" class="form-control form-control-lg border-2"
                       @bind="inputYear" placeholder="e.g., 2016" min="1" max="9999" />
            </div>
            <div class="col-md-5 d-grid align-self-end">
                <button class="btn btn-primary btn-lg shadow-sm" @onclick="GenerateCalendar">
                    <i class="bi bi-calendar-check-fill me-2"></i> Calculate Calendar
                </button>
            </div>
        </div>

        @if (holidaysList != null && holidaysList.Any())
        {
            <div class="d-grid mt-3">
                <button class="btn btn-outline-secondary btn-lg" @onclick="PrintPage">
                    🖨️ Download as PDF
                </button>
            </div>
        }
    </div>

    <!-- Results Display -->
    @if (holidaysList != null && holidaysList.Any())
    {
        <div class="print-area">

            <div class="print-title text-center mb-4">
                <h1 class="fw-bold">ባሕረ ሐሳብ — Bahire Hasab</h1>
                <h2 class="fw-semibold text-muted">@inputYear E.C.</h2>
            </div>

            <div class="mb-4 max-width-results mx-auto screen-title">
                <h2 class="h3 fw-bold text-dark m-0">Results for the Year @inputYear E.C.</h2>
            </div>
            <hr class="mb-4" />

            <div class="row g-4">
                @foreach (var item in holidaysList)
                {
                    <div class="col-sm-12 col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 border-start border-4 @GetCardAccentClass(item.HolidayName)">
                            <div class="card-body">
                                <span class="badge bg-opacity-10 text-dark mb-2 @GetBadgeClass(item.HolidayName)">
                                    @item.DayOfWeek
                                </span>
                                <h5 class="card-title fw-bold text-dark text-truncate mb-3">@ToAmharic(item.HolidayName)</h5>

                                <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-2 mb-2">
                                    <span class="small text-muted fw-medium">Ethiopian (E.C.)</span>
                                    <span class="fw-bold text-primary">@ToAmharicMonth(item.EthiopianMonth) @item.EthiopianDay</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center bg-white border border-light p-2 rounded-2">
                                    <span class="small text-muted fw-medium">Gregorian (G.C.)</span>
                                    <span class="fw-bold text-success">@item.GregorianMonth @item.GregorianDay, @item.GregorianYear</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private int inputYear = 2018;
    private List<HolidayModel>? holidaysList;

    private static readonly Dictionary<string, string> AmharicNames = new(StringComparer.OrdinalIgnoreCase)
    {
        { "Tahisas",                    "ታኅሣሥ"                  },
        { "Tahsas",                     "ታኅሣሥ"                  },
        { "Miazia",                     "ሚያዝያ"                  },
        { "Miyazya",                    "ሚያዝያ"                  },
        { "Adis Amet",                  "አዲስ አመት"               },
        { "Meskel",                     "መስቀል"                   },
        { "Tsome Nebiyat",              "ጾመ ነቢያት (የገና ጾም)"               },
        { "Lidet",                      "ልደተ ክርስቶስ /የገና በዐል"              },
        { "Gena",                       "ልደተ ክርስቶስ /የገና በዐል"              },
        { "Tsome Gahad",                "ጾመ ጋድ(ገሃድ)"                },
        { "Timket",                     "ጥምቀት"                   },
        { "Tsome Nenewe",               "ጾመ ሰብአ ነነዌ"                },
        { "Tsome Nenewe Mefcha",        "ፆመ ነነዌ መፍቻ"           },
        { "Tsome Hudade",               "ዐቢይ ጾም (ጾመ ሁዳዴ)"                },
        { "Debre Zeyit",                "ደብረ ዘይት"               },
        { "Siklet",                     "ስቅለት"                   },
        { "Fasika",                     "ትንሣኤ"                    },
        { "Rikbe Kahinat",              "ርክበ ካህናት"              },
        { "Eriget",                     "ዕርገት"                   },
        { "Peraklitos",                 "ጰራቅሊጦስ"               },
        { "Tsome Hawariyat",            "ጾመ ሐዋርያት"              },
        { "Tsome Dehinet",              "ጾመ ድኅነት"               },
        { "Tsome Hawariyat Mefcha",     "ጾመ ሐዋርያት መፍቻ"        },
        { "Tsome Filseta Maryam",       "ጾመ ፍልሰታ ለማርያም"        },
        { "Debre Tabor",                "ደብረ ታቦር"               },
        { "Tsome Filseta Mefcha",       "ጾመ ፍልሰታ መፍቻ"         },
    };

    private static readonly Dictionary<string, string> AmharicMonths = new(StringComparer.OrdinalIgnoreCase)
    {
        { "Meskerem",   "መስከረም" },
        { "Tikemt",     "ጥቅምት"  },
        { "Hidar",      "ኅዳር"   },
        { "Tahsas",     "ታኅሣሥ"  },
        { "Tahisas",    "ታኅሣሥ"  },
        { "Tir",        "ጥር"    },
        { "Yekatit",    "የካቲት"  },
        { "Megabit",    "መጋቢት"  },
        { "Miyazya",    "ሚያዝያ"  },
        { "Miazia",     "ሚያዝያ"  },
        { "Ginbot",     "ግንቦት"  },
        { "Sene",       "ሰኔ"    },
        { "Hamle",      "ሐምሌ"   },
        { "Nehase",     "ነሐሴ"   },
        { "Pagume",     "ጳጉሜ"   }
    };

    private string ToAmharic(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return name;
        if (AmharicNames.TryGetValue(name.Trim(), out var exact)) return exact;
        foreach (var pair in AmharicNames)
        {
            if (name.Trim().StartsWith(pair.Key, StringComparison.OrdinalIgnoreCase))
                return pair.Value;
        }
        return name;
    }

    private string ToAmharicMonth(string month)
    {
        if (string.IsNullOrWhiteSpace(month)) return month;
        if (AmharicMonths.TryGetValue(month.Trim(), out var exact)) return exact;
        foreach (var pair in AmharicMonths)
        {
            if (month.Trim().StartsWith(pair.Key, StringComparison.OrdinalIgnoreCase))
                return pair.Value;
        }
        return month;
    }

    private void GenerateCalendar()
    {
        var calculator = new BahireHasabCalculator(inputYear);
        calculator.Verbose = 0;
        calculator.SaveToFile = 0;
        calculator.CalculateBahireHasab();

        holidaysList = calculator.AllText.Select(item => new HolidayModel
        {
            HolidayName = item.Item1,
            DayOfWeek = item.Item2,
            EthiopianMonth = item.Item3,
            EthiopianDay = item.Item4,
            GregorianMonth = item.Item5,
            GregorianDay = item.Item6,
            GregorianYear = item.Item7
        }).ToList();
    }

    private string GetCardAccentClass(string name)
    {
        if (name.Contains("ጾም") || name.Contains("ፆመ") ||
            name.ToLower().Contains("fast") || name.ToLower().Contains("tsome"))
            return "border-warning bg-light";
        return "border-success bg-white";
    }

    private string GetBadgeClass(string name)
    {
        if (name.Contains("ጾም") || name.Contains("ፆመ") ||
            name.ToLower().Contains("fast") || name.ToLower().Contains("tsome"))
            return "bg-warning text-dark";
        return "bg-success text-white";
    }

    public class HolidayModel
    {
        public string HolidayName { get; set; } = string.Empty;
        public string DayOfWeek { get; set; } = string.Empty;
        public string EthiopianMonth { get; set; } = string.Empty;
        public string EthiopianDay { get; set; } = string.Empty;
        public string GregorianMonth { get; set; } = string.Empty;
        public string GregorianDay { get; set; } = string.Empty;
        public string GregorianYear { get; set; } = string.Empty;
    }

    private async Task PrintPage()
    {
        await JS.InvokeVoidAsync("printPage");
    }
}
