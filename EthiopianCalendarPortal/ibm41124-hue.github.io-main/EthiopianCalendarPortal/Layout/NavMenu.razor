                <svg class="me-2 text-start" width="20" height="14" viewBox="0 0 3 2" aria-hidden="true" style="border-radius: 2px;">
                    <rect width="3" height="2" fill="#009639" />
                    <rect y="0.666" width="3" height="0.666" fill="#FEDD00" />
                    <rect y="1.333" width="3" height="0.666" fill="#EF3340" />
                    <circle cx="1.5" cy="1" r="0.4" fill="#0033A0" />
